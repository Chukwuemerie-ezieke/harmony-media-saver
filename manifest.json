{
  "manifest_version": 3,
  "name": "Harmony Media Saver",
  "version": "1.0.1",
  "description": "Finds direct downloadable audio and video files on the current page and saves them with Chrome's download manager.",
  "homepage_url": "https://github.com/Chukwuemerie-ezieke/harmony-media-saver",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "webRequest",
    "tabs",
    "storage",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Harmony Media Saver",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
